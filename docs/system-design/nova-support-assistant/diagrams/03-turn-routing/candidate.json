    {
      "dot": "rose",
      "title": "Guardrails first",
      "items": [
        "Emergency and credentials: fixed refusal",
        "Human request, fraud, disputes: escalate",
        "Account questions: answer + deflection note"
      ]
    },
    {
      "dot": "emerald",
      "title": "Grounding gate",
      "items": [
        "Relevance floor 0.30 skips the answer call",
        "Gate = 0.45 retrieval + 0.2 agreement + 0.35 citation",
        "Second ungrounded turn escalates"
      ]
    },
    {
      "dot": "amber",
      "title": "Refund branch",
      "items": [
        "A pending refund owns the next message",
        "Replies are fixed text, never generated",
        "Guardrails still outrank it"
      ]
