    {
      "dot": "amber",
      "title": "Refund route",
      "items": [
        "LLM only classifies intent",
        "Eligibility and ₹499 limit in code",
        "Ledger copied per session"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Groq is the only outbound model call",
        "Sign-on gates, does not authorise",
        "Ops console shares the same sign-in"
      ]
