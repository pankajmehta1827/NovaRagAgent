# Copy to .streamlit/secrets.toml to turn on Google sign-in.
# Without this file the sign-on page falls back to a clearly labelled demo entry.
#
# Create the OAuth client yourself in Google Cloud Console
# (APIs & Services > Credentials > Create OAuth client ID > Web application) and
# add the redirect_uri below to its "Authorised redirect URIs". Never commit the
# filled-in secrets.toml — .gitignore already excludes it.

GROQ_API_KEY = "gsk_..."

[auth]
redirect_uri = "http://localhost:8502/oauth2callback"
cookie_secret = "generate-a-long-random-string"

[auth.google]
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
